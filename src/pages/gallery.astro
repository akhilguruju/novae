---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Gallery" description="Moments captured at Novae Glamp — night skies, tents, campfires, and golden hours.">
  <section class="page-hero section--full">
    <div class="container">
      <h1 data-reveal="up">Captured <em>moments</em></h1>
      <p class="page-hero__sub" data-reveal="fade" data-reveal-delay="0.2">
        What a night at Novae looks like.
      </p>
    </div>
  </section>

  <section class="section container">
    <p class="text-dim" data-reveal>Gallery page — coming in a later phase (immersive photo grid).</p>
  </section>
</Layout>

<style>
  .page-hero {
    padding-top: calc(var(--nav-h) + var(--space-2xl));
    text-align: center;
  }

  .page-hero__sub {
    margin-top: var(--space-md);
    font-size: var(--fs-lg);
    color: var(--starlight-dim);
    max-width: 50ch;
    margin-inline: auto;
  }
</style>
