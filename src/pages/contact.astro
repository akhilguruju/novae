---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Book Your Night" description="Reserve your night under the stars at Novae Glamp.">
  <section class="page-hero section--full">
    <div class="container">
      <h1 data-reveal="up">Reserve your <em>night</em></h1>
      <p class="page-hero__sub" data-reveal="fade" data-reveal-delay="0.2">
        Let's find you the perfect sky.
      </p>
    </div>
  </section>

  <section class="section container">
    <p class="text-dim" data-reveal>Booking & contact page — coming in a later phase.</p>
  </section>
</Layout>

<style>
  .page-hero {
    padding-top: calc(var(--nav-h) + var(--space-2xl));
    text-align: center;
  }

  .page-hero__sub {
    margin-top: var(--space-md);
    font-size: var(--fs-lg);
    color: var(--starlight-dim);
    max-width: 50ch;
    margin-inline: auto;
  }
</style>
