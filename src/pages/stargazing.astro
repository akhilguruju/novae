---
import Layout from '@/layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Bortle scale readout
const bortle = [
  { level: '1', label: 'Excellent dark sky' },
  { level: '2', label: 'Typical dark site' },
  { level: '3', label: 'Rural sky — Novae', active: true },
  { level: '4', label: 'Rural / suburban' },
  { level: '5', label: 'Suburban' },
  { level: '6', label: 'Bright suburban' },
  { level: '7', label: 'Suburban / urban' },
  { level: '8', label: 'City' },
  { level: '9', label: 'Inner city' },
];

// "Through the eyepiece" targets (rendered procedurally in canvas)
const targets = [
  { id: 'milkyway', name: 'The Milky Way', sub: 'Our galaxy, edge-on', nakedEye: 'A glowing river of light with dark dust lanes, straight overhead.', scope: 'Resolves into countless individual stars and star clouds.' },
  { id: 'saturn', name: 'Saturn', sub: 'The ringed planet', nakedEye: 'A steady golden point that does not twinkle.', scope: 'Rings snap into view, plus its largest moon, Titan.' },
  { id: 'jupiter', name: 'Jupiter', sub: 'Gas giant', nakedEye: 'The brightest star-like object after Venus.', scope: 'Cloud bands and four Galilean moons in a line.' },
  { id: 'moon', name: 'The Moon', sub: 'Our nearest neighbour', nakedEye: 'Seas and highlands visible to the unaided eye.', scope: 'Craters, mountains and terminator shadows in sharp relief.' },
  { id: 'orion', name: 'Orion Nebula', sub: 'M42 · stellar nursery', nakedEye: 'A faint fuzzy patch in Orion’s sword.', scope: 'Glowing gas clouds cradling the newborn Trapezium stars.' },
  { id: 'andromeda', name: 'Andromeda', sub: 'M31 · nearest galaxy', nakedEye: 'A dim smudge — the farthest thing visible to the naked eye.', scope: 'A vast tilted spiral, 2.5 million light-years away.' },
];

// Tonight's sky — by month (evening sky, ~17°N)
const sky = [
  { m: 'Jan', planets: 'Jupiter, Mars', shower: 'Quadrantids · Jan 3', showerHot: true, con: 'Orion · Taurus · Gemini' },
  { m: 'Feb', planets: 'Jupiter, Venus', shower: 'Quiet skies', showerHot: false, con: 'Orion · Canis Major · Gemini' },
  { m: 'Mar', planets: 'Venus, Mars', shower: 'Quiet skies', showerHot: false, con: 'Leo · Gemini · Ursa Major' },
  { m: 'Apr', planets: 'Venus (dawn)', shower: 'Lyrids · Apr 22', showerHot: true, con: 'Leo · Virgo · Ursa Major' },
  { m: 'May', planets: 'Mars, Venus', shower: 'Eta Aquariids · May 6', showerHot: true, con: 'Virgo · Boötes · Scorpius' },
  { m: 'Jun', planets: 'Saturn (dawn)', shower: 'Quiet skies', showerHot: false, con: 'Scorpius · Sagittarius · Hercules' },
  { m: 'Jul', planets: 'Saturn, galactic core', shower: 'δ-Aquariids · Jul 30', showerHot: true, con: 'Scorpius · Sagittarius · Cygnus' },
  { m: 'Aug', planets: 'Saturn', shower: 'Perseids · Aug 12', showerHot: true, con: 'Summer Triangle · Sagittarius' },
  { m: 'Sep', planets: 'Saturn, Jupiter', shower: 'Quiet skies', showerHot: false, con: 'Cygnus · Pegasus · Aquarius' },
  { m: 'Oct', planets: 'Jupiter, Saturn', shower: 'Orionids · Oct 21', showerHot: true, con: 'Pegasus · Andromeda · Perseus' },
  { m: 'Nov', planets: 'Jupiter, Mars', shower: 'Leonids · Nov 17', showerHot: true, con: 'Taurus · Pleiades · Andromeda' },
  { m: 'Dec', planets: 'Jupiter, Mars', shower: 'Geminids · Dec 14', showerHot: true, con: 'Orion · Taurus · Gemini' },
];

// The night, hour by hour
const timeline = [
  { time: '7:00', title: 'Arrival & dusk', desc: 'Settle in as the last light drains from the western sky and the first planets appear.' },
  { time: '7:30', title: 'Eyes adapt', desc: 'Screens off. Over the next 20 minutes your pupils widen and hundreds of hidden stars emerge.' },
  { time: '8:00', title: 'Naked-eye tour', desc: 'A host walks you across the sky — constellations, the ecliptic, and the plane of our galaxy.' },
  { time: '9:00', title: 'Telescope viewing', desc: 'Saturn’s rings, Jupiter’s moons, star clusters and nebulae through our guided setup.' },
  { time: '10:00', title: 'Astrophotography', desc: 'Bring a phone or camera — capture the Milky Way, star trails and long-exposure nightscapes.' },
  { time: 'Late', title: 'The galactic core', desc: 'On summer nights, the bright heart of the Milky Way climbs high over the plains.' },
];

// Field notes (tips)
const notes = [
  { num: '01', title: 'Give your eyes time', desc: 'Full dark adaptation takes 20–30 minutes. Even a glance at a phone resets your night vision.' },
  { num: '02', title: 'Check the Moon phase', desc: 'A bright Moon washes out faint objects. New-Moon nights are best for the Milky Way.' },
  { num: '03', title: 'Dress warm', desc: 'Temperatures drop after dark, even in summer. You’ll be standing still for a while.' },
  { num: '04', title: 'Look up, not through', desc: 'The best view at Novae is naked-eye. The telescope adds detail; the wide sky is the show.' },
];
---

<Layout title="Stargazing" description="Bortle Class 3 dark skies, 2,847 visible stars, guided telescope sessions, and the Milky Way with your naked eyes — 30 minutes from Hyderabad.">
  <!-- ============ HERO: dark-adapt → constellations → zoom-out ============ -->
  <section class="sg-hero" id="sg-hero">
    <div class="sg-hero__stage" id="sg-hero-stage">
      <canvas class="sg-hero__canvas" id="sg-sky" aria-hidden="true"></canvas>

      <div class="sg-hero__overlay" id="sg-hero-overlay">
        <p class="sg-hero__eyebrow">Glamp · Gaze · Glow</p>
        <h1 class="sg-hero__title" id="sg-hero-title">The sky<br /><em>is the show</em></h1>
        <p class="sg-hero__hint" id="sg-hero-hint">
          <span class="sg-hero__hint-desk">Move to explore · scroll to travel</span>
          <span class="sg-hero__hint-touch">Bortle 3 · 2,847 stars · scroll to travel</span>
        </p>
      </div>

      <div class="sg-hero__label" id="sg-constel-label" aria-hidden="true">
        <span class="sg-hero__label-name"></span>
        <span class="sg-hero__label-myth"></span>
      </div>

      <div class="sg-hero__outro" id="sg-hero-outro">
        <h2>One sky.<br /><em>One galaxy of many.</em></h2>
      </div>

      <div class="scroll-indicator" id="sg-hero-cue">
        <span class="scroll-indicator__label">Scroll</span>
        <span class="scroll-indicator__line"></span>
      </div>
    </div>
  </section>

  <!-- ============ BORTLE: wipe the city away ============ -->
  <section class="section sg-why" id="sg-why">
    <div class="container">
      <header class="sg-why__intro">
        <h2 data-reveal="up">This is why you drive<br /><em>thirty minutes.</em></h2>
        <p data-reveal="fade" data-reveal-delay="0.1">
          Light pollution erases the night. Drag the divider and watch the city glow lift away —
          from a washed-out handful of stars to the full sky Novae is built for.
        </p>
      </header>

      <div class="sg-compare" id="sg-compare" data-reveal="fade" data-reveal-delay="0.15">
        <canvas class="sg-compare__canvas" id="sg-compare-canvas" aria-hidden="true"></canvas>

        <span class="sg-compare__tag sg-compare__tag--city">
          <span class="sg-compare__place">Hyderabad</span>
          <span class="sg-compare__bortle">Bortle 8</span>
        </span>
        <span class="sg-compare__tag sg-compare__tag--novae">
          <span class="sg-compare__place">Novae Glamp</span>
          <span class="sg-compare__bortle">Bortle 3</span>
        </span>

        <div class="sg-compare__counter" id="sg-compare-counter">
          <span class="sg-compare__num" id="sg-compare-num">1,400</span>
          <span class="sg-compare__cap">stars overhead</span>
        </div>

        <button
          class="sg-compare__handle"
          id="sg-compare-handle"
          role="slider"
          aria-label="Reveal Novae's sky"
          aria-valuemin="0"
          aria-valuemax="100"
          aria-valuenow="50"
          tabindex="0"
        >
          <span class="sg-compare__grip"></span>
        </button>
      </div>

      <div class="sg-scale" data-reveal="fade">
        <div class="sg-scale__bar" aria-hidden="true">
          {bortle.map((b) => (
            <span class={`sg-scale__seg ${b.active ? 'sg-scale__seg--active' : ''}`} data-level={b.level}>
              <span class="sg-scale__num">{b.level}</span>
              {b.active && <span class="sg-scale__flag">Novae · {b.label.split('—')[0].trim()}</span>}
            </span>
          ))}
        </div>
        <div class="sg-scale__ends">
          <span>Pristine dark</span>
          <span>Inner city</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ THROUGH THE EYEPIECE ============ -->
  <section class="section sg-scope" id="sg-scope">
    <div class="sg-scope__spread container">
      <div class="sg-scope__viewer" data-reveal="scale">
        <div class="sg-scope__eyepiece">
          <canvas id="sg-scope-canvas" aria-hidden="true"></canvas>
          <span class="sg-scope__reticle" aria-hidden="true"></span>
          <span class="sg-scope__ring" aria-hidden="true"></span>
        </div>
      </div>

      <div class="sg-scope__panel">
        <h2 data-reveal="up">Through the<br /><em>eyepiece</em></h2>
        <p data-reveal="fade" data-reveal-delay="0.1">
          On a clear night your naked eyes do most of the work. Our telescopes do the rest.
          Choose a target and bring it into focus.
        </p>

        <div class="sg-scope__targets" id="sg-scope-targets" data-reveal="fade" data-reveal-delay="0.15">
          {targets.map((t, i) => (
            <button class={`sg-scope__target ${i === 0 ? 'is-active' : ''}`} data-target={t.id}>
              {t.name}
            </button>
          ))}
        </div>

        <div class="sg-scope__info" id="sg-scope-info" data-reveal="fade" data-reveal-delay="0.2">
          <h3 class="sg-scope__name" id="sg-scope-name">The Milky Way</h3>
          <p class="sg-scope__desc" id="sg-scope-sub">Our galaxy, edge-on</p>
          <dl class="sg-scope__facts">
            <div>
              <dt>Naked eye</dt>
              <dd id="sg-scope-naked">A glowing river of light with dark dust lanes, straight overhead.</dd>
            </div>
            <div>
              <dt>Through the scope</dt>
              <dd id="sg-scope-tele">Resolves into countless individual stars and star clouds.</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ TONIGHT'S SKY ============ -->
  <section class="section sg-tonight" id="sg-tonight">
    <div class="container">
      <h2 class="text-center" data-reveal="up">What’s up <em>tonight</em></h2>
      <p class="sg-tonight__lead text-center" data-reveal="fade" data-reveal-delay="0.1">
        The sky changes with the seasons. Pick a month to plan your night.
      </p>

      <div class="sg-tonight__months" id="sg-tonight-months" role="tablist" aria-label="Month" data-reveal="fade">
        {sky.map((s, i) => (
          <button class={`sg-month ${i === 6 ? 'is-active' : ''}`} role="tab" data-month={String(i)}>{s.m}</button>
        ))}
      </div>

      <div class="sg-tonight__spread" data-reveal="fade" data-reveal-delay="0.1">
        <div class="sg-orrery" aria-hidden="true">
          <span class="sg-orrery__sun"></span>
          <span class="sg-orrery__ring sg-orrery__ring--1"><span class="sg-orrery__planet"></span></span>
          <span class="sg-orrery__ring sg-orrery__ring--2"><span class="sg-orrery__planet"></span></span>
          <span class="sg-orrery__ring sg-orrery__ring--3"><span class="sg-orrery__planet"></span></span>
          <span class="sg-orrery__ring sg-orrery__ring--4"><span class="sg-orrery__planet"></span></span>
        </div>

        <div class="sg-tonight__panel" id="sg-tonight-panel">
          <div class="sg-fact">
            <span class="sg-fact__key">Planets</span>
            <span class="sg-fact__val" id="sg-fact-planets">Saturn, galactic core</span>
          </div>
          <div class="sg-fact">
            <span class="sg-fact__key">Meteor shower</span>
            <span class="sg-fact__val" id="sg-fact-shower">δ-Aquariids · Jul 30</span>
          </div>
          <div class="sg-fact">
            <span class="sg-fact__key">Best constellations</span>
            <span class="sg-fact__val" id="sg-fact-con">Scorpius · Sagittarius · Cygnus</span>
          </div>
          <div class="sg-fact">
            <span class="sg-fact__key">Darkest nights</span>
            <span class="sg-fact__val">Within a few days of the new moon</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ THE NIGHT, HOUR BY HOUR ============ -->
  <section class="section sg-timeline" id="sg-timeline">
    <div class="container">
      <h2 class="text-center" data-reveal="up">Your night, <em>hour by hour</em></h2>
      <div class="sg-timeline__track" id="sg-timeline-track">
        <span class="sg-timeline__line" aria-hidden="true"></span>
        <span class="sg-timeline__fill" id="sg-timeline-fill" aria-hidden="true"></span>
        {timeline.map((t, i) => (
          <div class={`sg-tl ${i % 2 === 0 ? 'sg-tl--left' : 'sg-tl--right'}`} data-reveal={i % 2 === 0 ? 'right' : 'left'}>
            <span class="sg-tl__dot" aria-hidden="true"></span>
            <span class="sg-tl__time">{t.time}</span>
            <div class="sg-tl__body">
              <h3>{t.title}</h3>
              <p>{t.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ IMAGE BAND ============ -->
  <section class="sg-band">
    <div class="sg-band__grid container">
      <div class="sg-band__item sg-band__item--wide" data-reveal="scale">
        <img src={`${base}/assets/activities/couple-stargazing.png`} alt="Couple stargazing at Novae" loading="lazy" />
      </div>
      <div class="sg-band__item" data-reveal="scale" data-reveal-delay="0.06">
        <img src={`${base}/assets/experiences/kids&telescope.jpg`} alt="Kids at the telescope" loading="lazy" />
      </div>
      <div class="sg-band__item" data-reveal="scale" data-reveal-delay="0.12">
        <img src={`${base}/assets/activities/telescope_pointing.jpg`} alt="Guided telescope session" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- ============ FIELD NOTES ============ -->
  <section class="section sg-notes">
    <div class="container">
      <h2 class="text-center" data-reveal="up">Field notes</h2>
      <div class="sg-notes__grid">
        {notes.map((n, i) => (
          <div class="sg-note" data-reveal="up" data-reveal-delay={String(i * 0.08)}>
            <span class="sg-note__num">{n.num}</span>
            <h3>{n.title}</h3>
            <p>{n.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CTA + NEW MOON COUNTDOWN ============ -->
  <section class="section section--full sg-cta">
    <div class="container text-center">
      <p class="sg-cta__moon" id="sg-cta-moon" data-reveal="fade">
        <span class="sg-cta__moon-dot" aria-hidden="true"></span>
        <span id="sg-cta-moon-text">Finding the next new moon…</span>
      </p>
      <h2 data-reveal="up">2,847 stars<br />are <em>waiting.</em></h2>
      <p class="sg-cta__sub" data-reveal="fade" data-reveal-delay="0.1">
        Every stay at Novae includes a guided stargazing session.
      </p>
      <a href={`${base}/contact`} class="btn btn--ember" data-reveal="fade" data-reveal-delay="0.2">
        <span>Book Your Night</span>
      </a>
    </div>
  </section>
</Layout>

<style>
  /* ============================================================
     STARGAZING — "The Observatory"
     A page that behaves like an instrument, not a brochure.
     ============================================================ */

  /* --- HERO --- */
  .sg-hero {
    position: relative;
    height: 240vh;            /* scroll distance for the zoom-out */
    background: var(--void);
  }

  .sg-hero__stage {
    position: relative;
    height: 100vh;
    width: 100%;
    overflow: hidden;
    background:
      radial-gradient(120% 80% at 50% 120%, rgba(232, 148, 74, 0.05), transparent 60%),
      var(--void);
  }

  .sg-hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .sg-hero__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    pointer-events: none;
    z-index: 2;
    padding-inline: var(--container-pad);
  }

  .sg-hero__eyebrow {
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.4em;
    color: var(--starlight-dim);
    margin-bottom: var(--space-md);
    padding-left: 0.4em;
  }

  .sg-hero__title {
    font-size: var(--fs-hero);
    line-height: 1.05;
    margin: 0;
    text-shadow: 0 0 40px rgba(6, 6, 8, 0.8);
  }

  .sg-hero__hint {
    margin-top: var(--space-lg);
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: var(--starlight-dim);
  }

  .sg-hero__hint-touch { display: none; }

  .sg-hero__label {
    position: absolute;
    top: 0;
    left: 0;
    transform: translate(-50%, -140%);
    text-align: center;
    pointer-events: none;
    opacity: 0;
    transition: opacity var(--duration-base) ease;
    z-index: 3;
    width: max-content;
    max-width: 240px;
  }

  .sg-hero__label-name {
    display: block;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--fs-lg);
    color: var(--starlight);
    letter-spacing: 0.02em;
  }

  .sg-hero__label-myth {
    display: block;
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    color: var(--starlight-dim);
    margin-top: 0.25rem;
    letter-spacing: 0.02em;
  }

  .sg-hero__outro {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    opacity: 0;
    pointer-events: none;
    z-index: 2;
    padding-inline: var(--container-pad);
  }

  .sg-hero__outro h2 {
    font-size: var(--fs-3xl);
    line-height: 1.1;
  }

  .sg-hero .scroll-indicator {
    z-index: 3;
  }

  /* --- BORTLE compare --- */
  .sg-why__intro {
    max-width: 60ch;
    margin-bottom: var(--space-2xl);
  }

  .sg-why__intro h2 {
    font-size: var(--fs-2xl);
    margin-bottom: var(--space-md);
  }

  .sg-why__intro p {
    color: var(--starlight-dim);
    line-height: 1.8;
  }

  .sg-compare {
    position: relative;
    width: 100%;
    aspect-ratio: 12 / 5;
    border-radius: var(--radius-lg);
    overflow: hidden;
    cursor: ew-resize;
    user-select: none;
    touch-action: pan-y;
    box-shadow: 0 30px 80px -40px rgba(0, 0, 0, 0.9);
  }

  .sg-compare__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .sg-compare__tag {
    position: absolute;
    top: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    font-family: var(--font-body);
    z-index: 2;
    pointer-events: none;
  }

  .sg-compare__tag--city { left: var(--space-md); }
  .sg-compare__tag--novae { right: var(--space-md); text-align: right; }

  .sg-compare__place {
    font-size: var(--fs-sm);
    letter-spacing: 0.05em;
    color: var(--starlight);
  }

  .sg-compare__bortle {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--starlight-dim);
  }

  .sg-compare__tag--novae .sg-compare__bortle { color: var(--ember); }

  .sg-compare__counter {
    position: absolute;
    right: var(--space-md);
    bottom: var(--space-md);
    text-align: right;
    z-index: 2;
    pointer-events: none;
  }

  .sg-compare__num {
    display: block;
    font-family: var(--font-display);
    font-size: var(--fs-2xl);
    font-weight: 300;
    line-height: 1;
    color: var(--starlight);
    font-variant-numeric: tabular-nums;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.9);
  }

  .sg-compare__cap { text-shadow: 0 1px 10px rgba(0, 0, 0, 0.9); }

  .sg-compare__cap {
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--starlight-dim);
  }

  .sg-compare__handle {
    position: absolute;
    top: 0;
    left: 50%;
    height: 100%;
    width: 44px;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    cursor: ew-resize;
    touch-action: none;
  }

  .sg-compare__handle::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: rgba(240, 235, 227, 0.6);
    box-shadow: 0 0 12px rgba(240, 235, 227, 0.4);
  }

  .sg-compare__grip {
    position: relative;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(6, 6, 8, 0.5);
    border: 1px solid rgba(240, 235, 227, 0.6);
    backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--duration-fast) ease, border-color var(--duration-fast) ease;
  }

  .sg-compare__grip::before,
  .sg-compare__grip::after {
    content: '';
    position: absolute;
    width: 0;
    height: 0;
    border-block: 5px solid transparent;
  }

  .sg-compare__grip::before {
    left: 11px;
    border-right: 7px solid rgba(240, 235, 227, 0.8);
  }

  .sg-compare__grip::after {
    right: 11px;
    border-left: 7px solid rgba(240, 235, 227, 0.8);
  }

  .sg-compare__handle:hover .sg-compare__grip,
  .sg-compare__handle:focus-visible .sg-compare__grip {
    transform: scale(1.12);
    border-color: var(--ember);
    outline: none;
  }

  /* Bortle scale bar */
  .sg-scale {
    margin-top: var(--space-2xl);
  }

  .sg-scale__bar {
    display: grid;
    grid-template-columns: repeat(9, 1fr);
    border-radius: var(--radius-pill);
    overflow: visible;
    height: 10px;
    background: linear-gradient(90deg,
      #05060a 0%, #0a0d16 22%, #17203a 40%,
