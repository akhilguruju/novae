---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="About" description="The story of Novae Glamp — born from a love of dark skies.">
  <section class="page-hero section--full">
    <div class="container">
      <h1 data-reveal="up">Born from a love<br />of <em>dark skies</em></h1>
      <p class="page-hero__sub" data-reveal="fade" data-reveal-delay="0.2">
        What started as a dream became Telangana's most intentional escape.
      </p>
    </div>
  </section>

  <section class="section container">
    <p class="text-dim" data-reveal>About page — coming in a later phase.</p>
  </section>
</Layout>

<style>
  .page-hero {
    padding-top: calc(var(--nav-h) + var(--space-2xl));
    text-align: center;
  }

  .page-hero__sub {
    margin-top: var(--space-md);
    font-size: var(--fs-lg);
    color: var(--starlight-dim);
    max-width: 50ch;
    margin-inline: auto;
  }
</style>
