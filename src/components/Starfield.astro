---

---

<canvas class="starfield" id="starfield-canvas" aria-hidden="true"></canvas>

<style>
  .starfield {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>

<script>
  const canvas = document.getElementById('starfield-canvas') as HTMLCanvasElement;
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    let w = 0;
    let h = 0;
    let scrollY = 0;
    let visible = true;

    interface Star {
      x: number;
      y: number;
      size: number;
      baseAlpha: number;
      twinkleSpeed: number;
      twinkleOffset: number;
      layer: number;
    }

    interface ShootingStar {
      x: number;
      y: number;
      vx: number;
      vy: number;
      life: number;
      maxLife: number;
      size: number;
      tailLength: number;
    }

    interface Ember {
      x: number;
      y: number;
      size: number;
      alpha: number;
      speed: number;
      drift: number;
      phase: number;
    }

    interface Galaxy {
      x: number;
      y: number;
      size: number;
      angle: number;
      tilt: number;
      alpha: number;
      colorType: number; // 0=blue, 1=warm, 2=purple, 3=teal, 4=rose
      arms: number;
      layer: number;
    }

    let stars: Star[] = [];
    let shootingStars: ShootingStar[] = [];
    let embers: Ember[] = [];
    let galaxies: Galaxy[] = [];
    let lastShootingTime = 0;

    function createStars() {
      stars = [];
      const count = Math.floor((w * h) / 2500);
      for (let i = 0; i < count; i++) {
        stars.push({
          x: Math.random() * w,
          y: Math.random() * h * 3,
          size: Math.random() * 2 + 0.3,
          baseAlpha: Math.random() * 0.6 + 0.2,
          twinkleSpeed: Math.random() * 2 + 0.5,
          twinkleOffset: Math.random() * Math.PI * 2,
          layer: Math.random() < 0.3 ? 2 : Math.random() < 0.6 ? 1 : 0,
        });
      }
    }

    function spawnShootingStar() {
      const dir = Math.random();
      let startX: number, startY: number, angle: number;

      if (dir < 0.35) {
        // Top-left to bottom-right (classic)
        startX = Math.random() * w * 0.7;
        startY = Math.random() * h * 0.3;
        angle = (Math.random() * 30 + 15) * (Math.PI / 180);
      } else if (dir < 0.6) {
        // Top-right to bottom-left
        startX = w * 0.3 + Math.random() * w * 0.7;
        startY = Math.random() * h * 0.3;
        angle = Math.PI - (Math.random() * 30 + 15) * (Math.PI / 180);
      } else if (dir < 0.8) {
        // Right to left (shallow)
        startX = w * 0.6 + Math.random() * w * 0.4;
        startY = Math.random() * h * 0.5;
        angle = Math.PI + (Math.random() * 20 - 10) * (Math.PI / 180);
      } else {
        // Nearly vertical downward
        startX = Math.random() * w;
        startY = -10;
        angle = (Math.random() * 20 + 70) * (Math.PI / 180);
      }

      const speed = Math.random() * 8 + 6;
      shootingStars.push({
        x: startX,
        y: startY,
        vx: Math.cos(angle) * speed,
        vy: Math.sin(angle) * speed,
        life: 0,
        maxLife: Math.random() * 40 + 30,
        size: Math.random() * 1.5 + 1,
        tailLength: Math.random() * 60 + 40,
      });
    }

    function resize() {
      const dpr = Math.min(window.devicePixelRatio, 2);
      w = window.innerWidth;
      h = window.innerHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      canvas.style.width = w + 'px';
      canvas.style.height = h + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      createStars();
      createEmbers();
      createGalaxies();
    }

    function createEmbers() {
      embers = [];
      for (let i = 0; i < 6; i++) {
        embers.push({
          x: Math.random() * w,
          y: Math.random() * h,
          size: 1.5 + Math.random() * 2,
          alpha: 0.06 + Math.random() * 0.08,
          speed: 0.15 + Math.random() * 0.15,
          drift: Math.random() * Math.PI * 2,
          phase: Math.random() * Math.PI * 2,
        });
      }
    }

    function createGalaxies() {
      galaxies = [];
      // 8 guaranteed galaxies spread across 4 viewport bands (2 per band)
      // ensures at least 2 visible at any scroll position
      const positions = [
        { bx: 0.2, by: 0.3 },  { bx: 0.75, by: 0.7 },
        { bx: 0.15, by: 1.2 }, { bx: 0.8, by: 1.6 },
        { bx: 0.5, by: 2.0 },  { bx: 0.25, by: 2.4 },
        { bx: 0.7, by: 0.1 },  { bx: 0.45, by: 2.8 },
      ];
      for (let i = 0; i < positions.length; i++) {
        const jitterX = (Math.random() - 0.5) * w * 0.15;
        const jitterY = (Math.random() - 0.5) * h * 0.2;
        galaxies.push({
          x: positions[i].bx * w + jitterX,
          y: positions[i].by * h + jitterY,
          size: 30 + Math.random() * 50,
          angle: Math.random() * Math.PI * 2,
          tilt: 0.35 + Math.random() * 0.45,
          alpha: 0.15 + Math.random() * 0.15,
          colorType: i % 5,
          arms: Math.random() < 0.25 ? 0 : (2 + Math.floor(Math.random() * 3)),
          layer: Math.random() < 0.5 ? 0 : 1,
        });
      }
    }

    const galaxyPalettes = [
      // Saturated, vivid colors
      { core: [180, 200, 255], mid: [120, 150, 255], arm: [100, 140, 255], haze: [80, 120, 230] },
      { core: [255, 230, 180], mid: [255, 200, 120], arm: [255, 180, 80],  haze: [230, 170, 100] },
      { core: [230, 170, 255], mid: [200, 120, 255], arm: [180, 100, 255], haze: [160, 80, 230] },
      { core: [140, 255, 245], mid: [80, 230, 220],  arm: [60, 210, 210],  haze: [50, 190, 200] },
      { core: [255, 180, 200], mid: [255, 140, 170], arm: [255, 110, 150], haze: [230, 100, 140] },
    ];

    function drawGalaxy(g: Galaxy, sy: number, time: number) {
      ctx.save();
      ctx.translate(g.x, sy);
      ctx.rotate(g.angle + time * 0.00002);

      const pulse = 0.85 + 0.15 * Math.sin(time * 0.0003 + g.x);
      const a = g.alpha * pulse;
      const pal = galaxyPalettes[g.colorType];

      if (g.arms === 0) {
        // Elliptical — big soft glow
        const grad = ctx.createRadialGradient(0, 0, 0, 0, 0, g.size);
        grad.addColorStop(0, `rgba(${pal.core[0]}, ${pal.core[1]}, ${pal.core[2]}, ${Math.min(a * 4, 1)})`);
        grad.addColorStop(0.2, `rgba(${pal.mid[0]}, ${pal.mid[1]}, ${pal.mid[2]}, ${Math.min(a * 2.5, 0.8)})`);
        grad.addColorStop(0.5, `rgba(${pal.haze[0]}, ${pal.haze[1]}, ${pal.haze[2]}, ${Math.min(a * 1.2, 0.5)})`);
        grad.addColorStop(1, 'rgba(0,0,0,0)');

        ctx.scale(1, g.tilt);
        ctx.beginPath();
        ctx.arc(0, 0, g.size, 0, Math.PI * 2);
        ctx.fillStyle = grad;
        ctx.fill();
      } else {
        // Spiral galaxy
        ctx.scale(1, g.tilt);

        // Bright core
        const coreGrad = ctx.createRadialGradient(0, 0, 0, 0, 0, g.size * 0.4);
        coreGrad.addColorStop(0, `rgba(${pal.core[0]}, ${pal.core[1]}, ${pal.core[2]}, ${Math.min(a * 5, 1)})`);
        coreGrad.addColorStop(0.4, `rgba(${pal.mid[0]}, ${pal.mid[1]}, ${pal.mid[2]}, ${Math.min(a * 2.5, 0.7)})`);
        coreGrad.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.beginPath();
        ctx.arc(0, 0, g.size * 0.4, 0, Math.PI * 2);
        ctx.fillStyle = coreGrad;
        ctx.fill();

        // Thick spiral arms
        for (let arm = 0; arm < g.arms; arm++) {
          const armOffset = (arm / g.arms) * Math.PI * 2;
          ctx.beginPath();
          for (let t = 0; t < 100; t++) {
            const theta = armOffset + t * 0.07;
            const r = (t / 100) * g.size;
            const px = Math.cos(theta) * r;
            const py = Math.sin(theta) * r;
            if (t === 0) ctx.moveTo(px, py);
            else ctx.lineTo(px, py);
          }
          ctx.strokeStyle = `rgba(${pal.arm[0]}, ${pal.arm[1]}, ${pal.arm[2]}, ${Math.min(a * 2.5, 0.6)})`;
          ctx.lineWidth = g.size * 0.09;
          ctx.lineCap = 'round';
          ctx.stroke();
        }

        // Wide outer haze
        const outerGrad = ctx.createRadialGradient(0, 0, g.size * 0.1, 0, 0, g.size * 1.2);
        outerGrad.addColorStop(0, `rgba(${pal.haze[0]}, ${pal.haze[1]}, ${pal.haze[2]}, ${Math.min(a * 1.2, 0.4)})`);
        outerGrad.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.beginPath();
        ctx.arc(0, 0, g.size * 1.2, 0, Math.PI * 2);
        ctx.fillStyle = outerGrad;
        ctx.fill();
      }

      ctx.restore();
    }

    function draw(time: number) {
      if (!visible) { requestAnimationFrame(draw); return; }

      ctx.clearRect(0, 0, w, h);

      const parallaxFactors = [0.02, 0.05, 0.1];

      // Draw galaxies behind everything
      for (const g of galaxies) {
        const parallax = scrollY * parallaxFactors[g.layer];
        const gy = ((g.y - parallax) % (h * 3) + h * 3) % (h * 3);
        if (gy > h + g.size * 2 || gy < -g.size * 2) continue;
        drawGalaxy(g, gy, time);
      }

      for (const star of stars) {
        const parallax = scrollY * parallaxFactors[star.layer];
        const sy = ((star.y - parallax) % (h * 3) + h * 3) % (h * 3);
        if (sy > h + 5) continue;

        const twinkle = Math.sin(time * 0.001 * star.twinkleSpeed + star.twinkleOffset);
        const alpha = star.baseAlpha * (0.5 + 0.5 * twinkle);

        ctx.beginPath();
        ctx.arc(star.x, sy, star.size, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(240, 235, 227, ${alpha})`;
        ctx.fill();

        if (star.size > 1.5 && alpha > 0.5) {
          ctx.beginPath();
          ctx.arc(star.x, sy, star.size * 3, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(240, 235, 227, ${alpha * 0.08})`;
          ctx.fill();
        }
      }

      if (time - lastShootingTime > 3000 + Math.random() * 5000) {
        if (shootingStars.length < 2) {
          spawnShootingStar();
          lastShootingTime = time;
        }
      }

      for (let i = shootingStars.length - 1; i >= 0; i--) {
        const s = shootingStars[i];
        s.x += s.vx;
        s.y += s.vy;
        s.life++;

        const progress = s.life / s.maxLife;
        const fadeIn = Math.min(progress * 5, 1);
        const fadeOut = 1 - Math.max((progress - 0.6) / 0.4, 0);
        const alpha = fadeIn * fadeOut * 0.9;

        if (alpha > 0) {
          const grad = ctx.createLinearGradient(
            s.x, s.y,
            s.x - s.vx * (s.tailLength / Math.hypot(s.vx, s.vy)),
            s.y - s.vy * (s.tailLength / Math.hypot(s.vx, s.vy))
          );
          grad.addColorStop(0, `rgba(240, 235, 227, ${alpha})`);
          grad.addColorStop(0.3, `rgba(232, 148, 74, ${alpha * 0.6})`);
          grad.addColorStop(1, `rgba(232, 148, 74, 0)`);

          ctx.beginPath();
          ctx.moveTo(s.x, s.y);
          ctx.lineTo(
            s.x - s.vx * (s.tailLength / Math.hypot(s.vx, s.vy)),
            s.y - s.vy * (s.tailLength / Math.hypot(s.vx, s.vy))
          );
          ctx.strokeStyle = grad;
          ctx.lineWidth = s.size;
          ctx.lineCap = 'round';
          ctx.stroke();

          ctx.beginPath();
          ctx.arc(s.x, s.y, s.size * 1.5, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(255, 255, 255, ${alpha * 0.8})`;
          ctx.fill();
        }

        if (s.life >= s.maxLife) {
          shootingStars.splice(i, 1);
        }
      }

      // Ambient ember particles
      for (const e of embers) {
        e.y -= e.speed;
        e.x += Math.sin(time * 0.0005 + e.drift) * 0.3;
        if (e.y < -10) { e.y = h + 10; e.x = Math.random() * w; }

        const pulse = 0.6 + 0.4 * Math.sin(time * 0.001 + e.phase);
        const a = e.alpha * pulse;

        ctx.beginPath();
        ctx.arc(e.x, e.y, e.size, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(232, 148, 74, ${a})`;
        ctx.fill();

        ctx.beginPath();
        ctx.arc(e.x, e.y, e.size * 3, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(232, 148, 74, ${a * 0.2})`;
        ctx.fill();
      }

      requestAnimationFrame(draw);
    }

    resize();
    let resizeTimer: number;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(resize, 200) as unknown as number;
    });

    window.addEventListener('scroll', () => { scrollY = window.scrollY; }, { passive: true });

    document.addEventListener('visibilitychange', () => {
      visible = !document.hidden;
    });

    requestAnimationFrame(draw);
  }
</script>
