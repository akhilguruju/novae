---

---

<canvas class="starfield" id="starfield-canvas" aria-hidden="true"></canvas>

<style>
  .starfield {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>

<script>
  const canvas = document.getElementById('starfield-canvas') as HTMLCanvasElement;
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    let w = 0;
    let h = 0;
    let scrollY = 0;
    let visible = true;

    interface Star {
      x: number;
      y: number;
      size: number;
      baseAlpha: number;
      twinkleSpeed: number;
      twinkleOffset: number;
      layer: number;
    }

    interface ShootingStar {
      x: number;
      y: number;
      vx: number;
      vy: number;
      life: number;
      maxLife: number;
      size: number;
      tailLength: number;
    }

    let stars: Star[] = [];
    let shootingStars: ShootingStar[] = [];
    let lastShootingTime = 0;

    function createStars() {
      stars = [];
      const count = Math.floor((w * h) / 2500);
      for (let i = 0; i < count; i++) {
        stars.push({
          x: Math.random() * w,
          y: Math.random() * h * 3,
          size: Math.random() * 2 + 0.3,
          baseAlpha: Math.random() * 0.6 + 0.2,
          twinkleSpeed: Math.random() * 2 + 0.5,
          twinkleOffset: Math.random() * Math.PI * 2,
          layer: Math.random() < 0.3 ? 2 : Math.random() < 0.6 ? 1 : 0,
        });
      }
    }

    function spawnShootingStar() {
      const startX = Math.random() * w * 0.8;
      const startY = Math.random() * h * 0.4;
      const angle = (Math.random() * 30 + 15) * (Math.PI / 180);
      const speed = Math.random() * 8 + 6;
      shootingStars.push({
        x: startX,
        y: startY,
        vx: Math.cos(angle) * speed,
        vy: Math.sin(angle) * speed,
        life: 0,
        maxLife: Math.random() * 40 + 30,
        size: Math.random() * 1.5 + 1,
        tailLength: Math.random() * 60 + 40,
      });
    }

    function resize() {
      const dpr = Math.min(window.devicePixelRatio, 2);
      w = window.innerWidth;
      h = window.innerHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      canvas.style.width = w + 'px';
      canvas.style.height = h + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      createStars();
    }

    function draw(time: number) {
      if (!visible) { requestAnimationFrame(draw); return; }

      ctx.clearRect(0, 0, w, h);

      const parallaxFactors = [0.02, 0.05, 0.1];

      for (const star of stars) {
        const parallax = scrollY * parallaxFactors[star.layer];
        const sy = ((star.y - parallax) % (h * 3) + h * 3) % (h * 3);
        if (sy > h + 5) continue;

        const twinkle = Math.sin(time * 0.001 * star.twinkleSpeed + star.twinkleOffset);
        const alpha = star.baseAlpha * (0.5 + 0.5 * twinkle);

        ctx.beginPath();
        ctx.arc(star.x, sy, star.size, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(240, 235, 227, ${alpha})`;
        ctx.fill();

        if (star.size > 1.5 && alpha > 0.5) {
          ctx.beginPath();
          ctx.arc(star.x, sy, star.size * 3, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(240, 235, 227, ${alpha * 0.08})`;
          ctx.fill();
        }
      }

      if (time - lastShootingTime > 3000 + Math.random() * 5000) {
        if (shootingStars.length < 2) {
          spawnShootingStar();
          lastShootingTime = time;
        }
      }

      for (let i = shootingStars.length - 1; i >= 0; i--) {
        const s = shootingStars[i];
        s.x += s.vx;
        s.y += s.vy;
        s.life++;

        const progress = s.life / s.maxLife;
        const fadeIn = Math.min(progress * 5, 1);
        const fadeOut = 1 - Math.max((progress - 0.6) / 0.4, 0);
        const alpha = fadeIn * fadeOut * 0.9;

        if (alpha > 0) {
          const grad = ctx.createLinearGradient(
            s.x, s.y,
            s.x - s.vx * (s.tailLength / Math.hypot(s.vx, s.vy)),
            s.y - s.vy * (s.tailLength / Math.hypot(s.vx, s.vy))
          );
          grad.addColorStop(0, `rgba(240, 235, 227, ${alpha})`);
          grad.addColorStop(0.3, `rgba(232, 148, 74, ${alpha * 0.6})`);
          grad.addColorStop(1, `rgba(232, 148, 74, 0)`);

          ctx.beginPath();
          ctx.moveTo(s.x, s.y);
          ctx.lineTo(
            s.x - s.vx * (s.tailLength / Math.hypot(s.vx, s.vy)),
            s.y - s.vy * (s.tailLength / Math.hypot(s.vx, s.vy))
          );
          ctx.strokeStyle = grad;
          ctx.lineWidth = s.size;
          ctx.lineCap = 'round';
          ctx.stroke();

          ctx.beginPath();
          ctx.arc(s.x, s.y, s.size * 1.5, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(255, 255, 255, ${alpha * 0.8})`;
          ctx.fill();
        }

        if (s.life >= s.maxLife) {
          shootingStars.splice(i, 1);
        }
      }

      requestAnimationFrame(draw);
    }

    resize();
    let resizeTimer: number;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(resize, 200) as unknown as number;
    });

    window.addEventListener('scroll', () => { scrollY = window.scrollY; }, { passive: true });

    document.addEventListener('visibilitychange', () => {
      visible = !document.hidden;
    });

    requestAnimationFrame(draw);
  }
</script>
