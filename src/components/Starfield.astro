---

---

<canvas class="starfield" id="starfield-canvas" aria-hidden="true"></canvas>

<style>
  .starfield {
    position: fixed;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>

<script>
  const canvas = document.getElementById('starfield-canvas') as HTMLCanvasElement;
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    let w = 0;
    let h = 0;
    let scrollY = 0;
    let visible = true;

    interface Star {
      x: number;
      y: number;
      size: number;
      baseAlpha: number;
      twinkleSpeed: number;
      twinkleOffset: number;
      layer: number;
    }

    interface ShootingStar {
      x: number;
      y: number;
      vx: number;
      vy: number;
      life: number;
      maxLife: number;
      size: number;
      tailLength: number;
    }

    interface Ember {
      x: number;
      y: number;
      size: number;
      alpha: number;
      speed: number;
      drift: number;
      phase: number;
    }

    interface Galaxy {
      x: number;
      y: number;
      size: number;
      angle: number;
      tilt: number;
      alpha: number;
      hue: number; // 0=blue-white, 1=warm
      arms: number;
      layer: number;
    }

    let stars: Star[] = [];
    let shootingStars: ShootingStar[] = [];
    let embers: Ember[] = [];
    let galaxies: Galaxy[] = [];
    let lastShootingTime = 0;

    function createStars() {
      stars = [];
      const count = Math.floor((w * h) / 2500);
      for (let i = 0; i < count; i++) {
        stars.push({
          x: Math.random() * w,
          y: Math.random() * h * 3,
          size: Math.random() * 2 + 0.3,
          baseAlpha: Math.random() * 0.6 + 0.2,
          twinkleSpeed: Math.random() * 2 + 0.5,
          twinkleOffset: Math.random() * Math.PI * 2,
          layer: Math.random() < 0.3 ? 2 : Math.random() < 0.6 ? 1 : 0,
        });
      }
    }

    function spawnShootingStar() {
      const startX = Math.random() * w * 0.8;
      const startY = Math.random() * h * 0.4;
      const angle = (Math.random() * 30 + 15) * (Math.PI / 180);
      const speed = Math.random() * 8 + 6;
      shootingStars.push({
        x: startX,
        y: startY,
        vx: Math.cos(angle) * speed,
        vy: Math.sin(angle) * speed,
        life: 0,
        maxLife: Math.random() * 40 + 30,
        size: Math.random() * 1.5 + 1,
        tailLength: Math.random() * 60 + 40,
      });
    }

    function resize() {
      const dpr = Math.min(window.devicePixelRatio, 2);
      w = window.innerWidth;
      h = window.innerHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      canvas.style.width = w + 'px';
      canvas.style.height = h + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      createStars();
      createEmbers();
      createGalaxies();
    }

    function createEmbers() {
      embers = [];
      for (let i = 0; i < 6; i++) {
        embers.push({
          x: Math.random() * w,
          y: Math.random() * h,
          size: 1.5 + Math.random() * 2,
          alpha: 0.06 + Math.random() * 0.08,
          speed: 0.15 + Math.random() * 0.15,
          drift: Math.random() * Math.PI * 2,
          phase: Math.random() * Math.PI * 2,
        });
      }
    }

    function createGalaxies() {
      galaxies = [];
      const count = Math.max(4, Math.floor((w * h) / 250000));
      for (let i = 0; i < count; i++) {
        galaxies.push({
          x: Math.random() * w,
          y: Math.random() * h * 3,
          size: 12 + Math.random() * 30,
          angle: Math.random() * Math.PI * 2,
          tilt: 0.3 + Math.random() * 0.5,
          alpha: 0.04 + Math.random() * 0.06,
          hue: Math.random(),
          arms: Math.random() < 0.4 ? 0 : (2 + Math.floor(Math.random() * 3)),
          layer: Math.random() < 0.5 ? 0 : 1,
        });
      }
    }

    function drawGalaxy(g: Galaxy, sy: number, time: number) {
      ctx.save();
      ctx.translate(g.x, sy);
      ctx.rotate(g.angle + time * 0.00002);

      const pulse = 0.85 + 0.15 * Math.sin(time * 0.0003 + g.x);
      const a = g.alpha * pulse;

      if (g.arms === 0) {
        // Elliptical galaxy — soft glowing ellipse
        const grad = ctx.createRadialGradient(0, 0, 0, 0, 0, g.size);
        if (g.hue < 0.5) {
          grad.addColorStop(0, `rgba(200, 210, 240, ${a * 2.5})`);
          grad.addColorStop(0.3, `rgba(180, 190, 220, ${a * 1.5})`);
          grad.addColorStop(0.7, `rgba(140, 150, 180, ${a * 0.5})`);
        } else {
          grad.addColorStop(0, `rgba(240, 220, 190, ${a * 2.5})`);
          grad.addColorStop(0.3, `rgba(230, 200, 170, ${a * 1.5})`);
          grad.addColorStop(0.7, `rgba(200, 170, 140, ${a * 0.5})`);
        }
        grad.addColorStop(1, 'rgba(0,0,0,0)');

        ctx.scale(1, g.tilt);
        ctx.beginPath();
        ctx.arc(0, 0, g.size, 0, Math.PI * 2);
        ctx.fillStyle = grad;
        ctx.fill();
      } else {
        // Spiral galaxy
        ctx.scale(1, g.tilt);

        // Core glow
        const coreGrad = ctx.createRadialGradient(0, 0, 0, 0, 0, g.size * 0.3);
        if (g.hue < 0.5) {
          coreGrad.addColorStop(0, `rgba(220, 225, 255, ${a * 3})`);
          coreGrad.addColorStop(0.5, `rgba(180, 190, 230, ${a * 1.5})`);
        } else {
          coreGrad.addColorStop(0, `rgba(255, 235, 210, ${a * 3})`);
          coreGrad.addColorStop(0.5, `rgba(240, 210, 180, ${a * 1.5})`);
        }
        coreGrad.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.beginPath();
        ctx.arc(0, 0, g.size * 0.3, 0, Math.PI * 2);
        ctx.fillStyle = coreGrad;
        ctx.fill();

        // Spiral arms
        for (let arm = 0; arm < g.arms; arm++) {
          const armOffset = (arm / g.arms) * Math.PI * 2;
          ctx.beginPath();
          for (let t = 0; t < 80; t++) {
            const theta = armOffset + t * 0.08;
            const r = (t / 80) * g.size;
            const px = Math.cos(theta) * r;
            const py = Math.sin(theta) * r;
            if (t === 0) ctx.moveTo(px, py);
            else ctx.lineTo(px, py);
          }
          const armAlpha = a * 1.2;
          ctx.strokeStyle = g.hue < 0.5
            ? `rgba(180, 195, 240, ${armAlpha})`
            : `rgba(230, 200, 170, ${armAlpha})`;
          ctx.lineWidth = g.size * 0.06;
          ctx.lineCap = 'round';
          ctx.stroke();
        }

        // Outer haze
        const outerGrad = ctx.createRadialGradient(0, 0, g.size * 0.2, 0, 0, g.size);
        outerGrad.addColorStop(0, `rgba(200, 210, 240, ${a * 0.4})`);
        outerGrad.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.beginPath();
        ctx.arc(0, 0, g.size, 0, Math.PI * 2);
        ctx.fillStyle = outerGrad;
        ctx.fill();
      }

      ctx.restore();
    }

    function draw(time: number) {
      if (!visible) { requestAnimationFrame(draw); return; }

      ctx.clearRect(0, 0, w, h);

      const parallaxFactors = [0.02, 0.05, 0.1];

      // Draw galaxies behind everything
      for (const g of galaxies) {
        const parallax = scrollY * parallaxFactors[g.layer];
        const gy = ((g.y - parallax) % (h * 3) + h * 3) % (h * 3);
        if (gy > h + g.size * 2 || gy < -g.size * 2) continue;
        drawGalaxy(g, gy, time);
      }

      for (const star of stars) {
        const parallax = scrollY * parallaxFactors[star.layer];
        const sy = ((star.y - parallax) % (h * 3) + h * 3) % (h * 3);
        if (sy > h + 5) continue;

        const twinkle = Math.sin(time * 0.001 * star.twinkleSpeed + star.twinkleOffset);
        const alpha = star.baseAlpha * (0.5 + 0.5 * twinkle);

        ctx.beginPath();
        ctx.arc(star.x, sy, star.size, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(240, 235, 227, ${alpha})`;
        ctx.fill();

        if (star.size > 1.5 && alpha > 0.5) {
          ctx.beginPath();
          ctx.arc(star.x, sy, star.size * 3, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(240, 235, 227, ${alpha * 0.08})`;
          ctx.fill();
        }
      }

      if (time - lastShootingTime > 3000 + Math.random() * 5000) {
        if (shootingStars.length < 2) {
          spawnShootingStar();
          lastShootingTime = time;
        }
      }

      for (let i = shootingStars.length - 1; i >= 0; i--) {
        const s = shootingStars[i];
        s.x += s.vx;
        s.y += s.vy;
        s.life++;

        const progress = s.life / s.maxLife;
        const fadeIn = Math.min(progress * 5, 1);
        const fadeOut = 1 - Math.max((progress - 0.6) / 0.4, 0);
        const alpha = fadeIn * fadeOut * 0.9;

        if (alpha > 0) {
          const grad = ctx.createLinearGradient(
            s.x, s.y,
            s.x - s.vx * (s.tailLength / Math.hypot(s.vx, s.vy)),
            s.y - s.vy * (s.tailLength / Math.hypot(s.vx, s.vy))
          );
          grad.addColorStop(0, `rgba(240, 235, 227, ${alpha})`);
          grad.addColorStop(0.3, `rgba(232, 148, 74, ${alpha * 0.6})`);
          grad.addColorStop(1, `rgba(232, 148, 74, 0)`);

          ctx.beginPath();
          ctx.moveTo(s.x, s.y);
          ctx.lineTo(
            s.x - s.vx * (s.tailLength / Math.hypot(s.vx, s.vy)),
            s.y - s.vy * (s.tailLength / Math.hypot(s.vx, s.vy))
          );
          ctx.strokeStyle = grad;
          ctx.lineWidth = s.size;
          ctx.lineCap = 'round';
          ctx.stroke();

          ctx.beginPath();
          ctx.arc(s.x, s.y, s.size * 1.5, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(255, 255, 255, ${alpha * 0.8})`;
          ctx.fill();
        }

        if (s.life >= s.maxLife) {
          shootingStars.splice(i, 1);
        }
      }

      // Ambient ember particles
      for (const e of embers) {
        e.y -= e.speed;
        e.x += Math.sin(time * 0.0005 + e.drift) * 0.3;
        if (e.y < -10) { e.y = h + 10; e.x = Math.random() * w; }

        const pulse = 0.6 + 0.4 * Math.sin(time * 0.001 + e.phase);
        const a = e.alpha * pulse;

        ctx.beginPath();
        ctx.arc(e.x, e.y, e.size, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(232, 148, 74, ${a})`;
        ctx.fill();

        ctx.beginPath();
        ctx.arc(e.x, e.y, e.size * 3, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(232, 148, 74, ${a * 0.2})`;
        ctx.fill();
      }

      requestAnimationFrame(draw);
    }

    resize();
    let resizeTimer: number;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(resize, 200) as unknown as number;
    });

    window.addEventListener('scroll', () => { scrollY = window.scrollY; }, { passive: true });

    document.addEventListener('visibilitychange', () => {
      visible = !document.hidden;
    });

    requestAnimationFrame(draw);
  }
</script>
