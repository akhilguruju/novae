---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="footer">
  <div class="footer__inner container">
    <div class="footer__top">
      <div class="footer__brand">
        <img src={`${base}/assets/NG_logo.svg`} alt="Novae Glamp" width="56" height="56" class="footer__logo" />
        <p class="footer__tagline">Glamp. Gaze. Glow.</p>
      </div>

      <nav class="footer__nav" aria-label="Footer navigation">
        <div class="footer__col">
          <h4 class="footer__heading">Explore</h4>
          <a href={`${base}/stays`} class="footer__link link-draw">Stays</a>
          <a href={`${base}/experiences`} class="footer__link link-draw">Experiences</a>
          <a href={`${base}/stargazing`} class="footer__link link-draw">Stargazing</a>
          <a href={`${base}/about`} class="footer__link link-draw">About Us</a>
          <a href={`${base}/gallery`} class="footer__link link-draw">Gallery</a>
        </div>
        <div class="footer__col">
          <h4 class="footer__heading">Stay With Us</h4>
          <a href={`${base}/stays#luxury-tepee`} class="footer__link link-draw">Luxury Tepee</a>
          <a href={`${base}/stays#american-tent`} class="footer__link link-draw">American Tent</a>
          <a href={`${base}/stays#suite-room`} class="footer__link link-draw">Suite Room</a>
          <a href={`${base}/stays#hut-tent`} class="footer__link link-draw">Hut Tent</a>
          <a href={`${base}/stays#dormitory`} class="footer__link link-draw">Dormitory</a>
          <a href={`${base}/stays#camping`} class="footer__link link-draw">Camping</a>
        </div>
        <div class="footer__col">
          <h4 class="footer__heading">Contact</h4>
          <a href="tel:+918886866631" class="footer__link link-draw">+91 888 686 6631</a>
          <a href="mailto:Bookings@novaeglamp.com" class="footer__link link-draw">Bookings@novaeglamp.com</a>
          <p class="footer__address">
            Maryala Village Road,<br />
            Bhuvanagiri, Telangana 508117
          </p>
        </div>
      </nav>
    </div>

    <div class="footer__bottom">
      <p class="footer__copy">&copy; {new Date().getFullYear()} Novae Glamp. All rights reserved.</p>
      <div class="footer__social">
        <a
          href="https://www.instagram.com/novaeglamphyd/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Instagram"
          class="footer__social-link"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5"/>
            <circle cx="12" cy="12" r="5"/>
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
          </svg>
        </a>
        <a
          href="https://www.facebook.com/novaeglamp"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Facebook"
          class="footer__social-link"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--starlight-faint);
    padding-block: var(--space-2xl) var(--space-xl);
    margin-top: var(--space-3xl);
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  .footer__top {
    display: flex;
    justify-content: space-between;
    gap: var(--space-2xl);
  }

  .footer__brand {
    flex-shrink: 0;
  }

  .footer__logo {
    opacity: 0.7;
    margin-bottom: var(--space-sm);
  }

  .footer__tagline {
    font-family: var(--font-display);
    font-size: var(--fs-md);
    font-style: italic;
    font-weight: 300;
    color: var(--starlight-dim);
    max-width: none;
  }

  .footer__nav {
    display: flex;
    gap: var(--space-2xl);
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .footer__heading {
    font-family: var(--font-body);
    font-size: var(--fs-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--starlight-dim);
    margin-bottom: var(--space-xs);
  }

  .footer__link {
    font-size: var(--fs-sm);
    color: var(--starlight-dim);
    transition: color var(--duration-fast) ease;
  }

  .footer__link:hover {
    color: var(--starlight);
  }

  .footer__address {
    font-size: var(--fs-sm);
    color: var(--starlight-dim);
    line-height: 1.6;
    max-width: none;
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-lg);
    border-top: 1px solid var(--starlight-faint);
  }

  .footer__copy {
    font-size: var(--fs-xs);
    color: var(--starlight-dim);
    max-width: none;
  }

  .footer__social {
    display: flex;
    gap: var(--space-md);
  }

  .footer__social-link {
    color: var(--starlight-dim);
    transition: color var(--duration-fast) ease;
  }

  .footer__social-link:hover {
    color: var(--starlight);
  }

  @media (max-width: 768px) {
    .footer__top {
      flex-direction: column;
    }

    .footer__nav {
      flex-direction: column;
      gap: var(--space-xl);
    }

    .footer__bottom {
      flex-direction: column;
      gap: var(--space-sm);
      text-align: center;
    }
  }
</style>
